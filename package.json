{
  "name": "mathcanvas",
  "version": "0.4.8",
  "private": true,
  "description": "MathCanvas - a desktop-first math problem solving canvas.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "web:build": "vite build",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.3",
    "firebase": "^13.0.0",
    "mathjs": "14.0.1",
    "mathlive": "0.110.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "9.2.1",
    "electron-builder": "26.0.12",
    "typescript": "5.9.2",
    "vite": "8.3.0",
    "wait-on": "9.0.1"
  },
  "build": {
    "appId": "com.mathcanvas.desktop",
    "productName": "MathCanvas",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    }
  }
}
